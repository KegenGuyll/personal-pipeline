# Copy to `stack/.env` and fill in. Never commit the real file.
# Note: in compose, a literal `$` in a value must be written as `$$`.

# ---- required ----

# Shared HMAC secret for the deploy webhook. Must be identical to the
# DEPLOY_WEBHOOK_SECRET GitHub secret you configure in each project repo.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Your GitHub username (or org), LOWERCASE — GHCR requires lowercase
# namespaces (e.g. "kegenguyll", not "KegenGuyll"). Tags the agent image.
GHCR_OWNER=

# Read-only GitHub token (classic PAT with `read:packages`, or a
# fine-grained token with read access to your packages) so the server can
# pull your private images from GHCR.
GHCR_USER=
GHCR_TOKEN=

# ---- optional (defaults shown) ----

# Comma-separated image prefixes the agent will accept. Tighten this to your
# own namespace (lowercase), e.g. ghcr.io/your_username/
ALLOWED_IMAGE_PREFIXES=ghcr.io/

# Bearer token for the read API (GET /deployments, GET /services — the
# dashboard). Empty disables the endpoints. Generate with: openssl rand -hex 16
READ_TOKEN=

# Bearer token for write actions in the dashboard (POST /services to add a
# service, POST /onboard to onboard a project). Separate from READ_TOKEN so
# listing is read-only. Empty disables adding services. Generate with:
# openssl rand -hex 16
ADMIN_TOKEN=

# ---- project onboarding (GitHub App) ----
# Onboarding creates the service compose file, sets each project's SERVICE_ENV
# secret, and opens a review PR that adds .github/workflows/deploy.yml.
# Leave GITHUB_APP_ID empty to disable onboarding (POST /onboard returns 404).
# See docs/onboarding.md for how to create the app and download the key.

# The numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=

# The GitHub App private key (PEM), base64-encoded on ONE line so it survives
# .env parsing. Generate the value with:
#   base64 -i github-app-key.pem | tr -d '\n'
# (quote the value if your shell/compose wants it: '...')
GITHUB_APP_PRIVATE_KEY_B64=

# Optional: explicit installation ID. If empty, the agent picks the
# installation whose account matches PIPELINE_OWNER (or the sole installation).
GITHUB_APP_INSTALLATION_ID=

# Owner (user or org, case-insensitive) of the personal-pipeline repo used in
# the generated `uses: <owner>/personal-pipeline/...` workflow line.
# Defaults to GHCR_OWNER.
PIPELINE_OWNER=

# Ref of the pipeline repo the generated workflow pins (`uses: ...@<ref>`).
PIPELINE_REF=main

# Notification webhook URL(s) + optional Go text/template body override.
# See docs/hooks-and-notifications.md for Discord/Slack/ntfy examples.
NOTIFY_WEBHOOK_URLS=
NOTIFY_TEMPLATE=
NOTIFY_CONTENT_TYPE=application/json

# Hook script timeout (seconds) and deployment-history retention (records).
HOOK_TIMEOUT=60
LOG_RETENTION=100

# Host port for the deploy agent. It binds all interfaces so a reverse proxy
# (e.g. Nginx Proxy Manager) can forward to it via the server's LAN IP:port.
# The public path is still Cloudflare Tunnel -> proxy -> this port. Default 9090.
AGENT_PORT=9090

# Agent image tag used by the bootstrap compose (defaults to `latest`).
AGENT_TAG=latest
