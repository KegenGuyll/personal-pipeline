# ntfy service runtime env — copy to the server as services/ntfy/.env
# (the deploy agent writes project-service env files from SERVICE_ENV, but ntfy
# is a static infra service with no project repo, so its .env is created here
# manually). Never commit a real .env; only this example is tracked.

# ── Required ──────────────────────────────────────────────────────────────

# Tailscale auth key for the per-app sidecar (reuse the existing key). The
# sidecar registers as <hostname>.<tailnet>.ts.net. Create one at the admin
# console -> Settings -> Keys -> Generate auth key (Reusable on, Ephemeral off).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Required for the ntfy server (read from env_file) ─────────────────────

# The public tailnet base URL. Must be HTTPS (the iOS ntfy app requires it) and
# must equal the MagicDNS hostname the sidecar registers, e.g.
#   https://ntfy.<tailnet>.ts.net
# ntfy uses this to generate correct absolute links/redirects in its web UI.
NTFY_BASE_URL=https://ntfy.<tailnet>.ts.net

# ntfy is served behind the Tailscale TLS reverse proxy, so it must trust the
# forwarded headers (correct scheme / client IP / base URL).
NTFY_BEHIND_PROXY=true

# REQUIRED for iOS push delivery. A self-hosted ntfy relays notifications to the
# phone through an upstream ntfy infrastructure; without this the iOS app stays
# subscribed but never receives an actual push. Point it at the public relay.
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# ── Optional ──────────────────────────────────────────────────────────────

# MagicDNS hostname for the sidecar (default: ntfy). Change only if the
# compose's `hostname` is overridden to match. When changed, NTFY_BASE_URL above
# must follow it.
#TS_HOSTNAME=ntfy

# Listen address (default :80 — matches the sidecar's Proxy target).
#NTFY_LISTEN=:80
